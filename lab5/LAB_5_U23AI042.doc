  q01: tally={&#x27;9&#x27;: 6, &#x27;15&#x27;: 1}  -&gt; ANSWERED 9  gold=9  [OK]
  q02: tally={&#x27;120&#x27;: 1, &#x27;150&#x27;: 6}  -&gt; ANSWERED 150  gold=150  [OK]
